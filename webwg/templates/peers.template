<script type="text/template" id="t-req-row">
  <div class="wg-req-who">
    <span class="wg-req-name"><%- name %></span>
    <span class="wg-req-meta">Requested <%- when %> from <span class="font-monospace"><%- ip %></span></span>
  </div>
  <div class="wg-req-field">
    <span class="wg-label">Address</span>
    <span class="font-monospace"><%- address %></span>
  </div>
  <div class="wg-req-actions">
    <button type="button" class="btn btn-quiet text-danger reject-req">Reject</button>
    <button type="button" class="btn btn-primary approve-req">
      <i class="bi bi-check-lg" aria-hidden="true"></i> Approve
    </button>
  </div>
</script>

<script type="text/template" id="t-peer-row">
  <td class="wg-status-<%- status %>"<% if (endpoint) { %> title="Connected from <%- endpoint %>"<% } %>><span class="wg-dot" aria-hidden="true"></span><%- statusLabel %></td>
  <td class="fw-semibold" title="<%- pub %>"><%- name %></td>
  <td class="font-monospace"><%- address %></td>
  <td class="wg-dim"><%- handshakeLabel %></td>
  <td class="text-end wg-num"><%- rxLabel %></td>
  <td class="text-end wg-num"><%- txLabel %></td>
  <td class="wg-dim"><%- added %></td>
  <td class="wg-actions">
    <% if (has_config) { %>
    <button type="button" class="btn btn-link show-config">
      <i class="bi bi-qr-code" aria-hidden="true"></i> Show config
    </button>
    <% } %>
    <button type="button" class="wg-icon-btn del-row" aria-label="Remove <%- name %>">
      <i class="bi bi-trash3" aria-hidden="true"></i>
    </button>
  </td>
</script>

<div class="modal fade" id="peer-modal" tabindex="-1" aria-labelledby="peer-modal-label" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title" id="peer-modal-label">New peer</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form class="wg-form" id="peer-new" novalidate>
          <div>
            <label for="peer-name" class="form-label">Name</label>
            <input type="text" class="form-control" id="peer-name" name="name" required maxlength="32" pattern="[A-Za-z0-9_.\-]+" aria-describedby="peer-name-hint">
            <div class="form-text" id="peer-name-hint">Letters, numbers, dots, dashes and underscores.</div>
          </div>
          <div>
            <label for="peer-instance" class="form-label">Server</label>
            <select class="form-select" id="peer-instance" name="instance"></select>
          </div>
          <div>
            <label for="peer-address" class="form-label">Address</label>
            <div class="input-group">
              <input type="text" class="form-control font-monospace" id="peer-address" name="address" required pattern="[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+" aria-describedby="peer-address-hint">
              <span class="input-group-text font-monospace">/32</span>
            </div>
            <div class="form-text" id="peer-address-hint"></div>
          </div>
          <p class="wg-note">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <span>WebWG generates this peer's keys. You'll see its config once, as a QR code and text, right after you create it.</span>
          </p>
          <div class="alert alert-danger" id="peer-error" role="alert" hidden></div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-quiet" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary" form="peer-new">Create peer</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="config-modal" tabindex="-1" aria-labelledby="config-title" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <div class="d-flex flex-column gap-1">
          <h2 class="modal-title" id="config-title"><span id="config-name"></span> is ready</h2>
          <span class="wg-muted" id="config-meta"></span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body d-flex flex-column gap-4">
        <p class="wg-note wg-note-warn" role="note">
          <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
          <span>This config holds the peer's private key and is shown only once. WebWG has already deleted its copy.</span>
        </p>
        <div class="wg-config-top">
          <img id="config-qr" alt="">
          <ol>
            <li>Open the WireGuard app on the device.</li>
            <li>Add a tunnel and scan this code, or import the downloaded file.</li>
            <li>Turn the tunnel on. Its status changes to Online here after the first handshake.</li>
          </ol>
        </div>
        <div class="d-flex flex-column gap-2">
          <div class="d-flex align-items-center justify-content-between gap-2">
            <span class="fw-medium">Config</span>
            <button type="button" class="btn btn-quiet" id="config-copy">
              <i class="bi bi-copy" aria-hidden="true"></i> <span class="label">Copy</span>
            </button>
          </div>
          <pre class="wg-code" id="config-text"></pre>
        </div>
      </div>
      <div class="modal-footer">
        <a class="btn btn-quiet" id="config-download">
          <i class="bi bi-download" aria-hidden="true"></i> <span id="config-download-label">Download</span>
        </a>
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Done</button>
      </div>
    </div>
  </div>
</div>
